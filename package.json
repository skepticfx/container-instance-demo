    "deploy": "npx --yes https://pkg.pr.new/wrangler@15141 deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260811.1",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "p-retry": "^8.0.0"
  }
}
